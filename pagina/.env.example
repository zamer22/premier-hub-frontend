# ── Backend ───────────────────────────────────────────────────────────────────
# URL base de la API (sin slash al final)
VITE_API_URL=https://api.tudominio.com

# URL pública del frontend (se usa como redirect_to en OAuth)
VITE_APP_URL=https://app.tudominio.com

# ── Supabase ──────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://supabase.tudominio.com
VITE_SUPABASE_ANON_KEY=         # Anon/public key (es seguro exponer al cliente)
